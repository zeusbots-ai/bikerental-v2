# ================================================================
# CUAP Hostel Bike/Scooty Rental Bot - Configuration
# ================================================================

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
TIMEZONE=Asia/Kolkata

# WhatsApp Web Bridge (Node.js companion process)
BRIDGE_PORT=3001
BRIDGE_URL=http://localhost:3001
FASTAPI_WEBHOOK_URL=http://localhost:8000/api/v1/whatsapp/webhook

# MongoDB Atlas
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/hostel_rental_db?retryWrites=true&w=majority
MONGODB_DB_NAME=hostel_rental_db

# Admins (Comma-separated phone numbers with country code, without + or spaces)
# Example for India (+91): 916371737949
ADMIN_PHONE_NUMBERS=916371737949

# WhatsApp Provider: 'web' (Local WhatsApp Web automation) or 'cloud' (Official Meta API)
WHATSAPP_PROVIDER=web

# Payment Provider: 'mock' (local testing) or 'razorpay'
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# Session & Media Storage Paths (Use /data/... for Railway persistent volume)
SESSION_DATA_PATH=./data/session
MEDIA_STORAGE_PATH=./data/media

# Business Rules
HOLD_EXPIRY_MINUTES=10
BOT_NAME="CUAP Wheels"
HOSTEL_NAME="Central University of Andhra Pradesh Hostel"
